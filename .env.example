# Tesla OAuth App credentials (from developer.tesla.com)
TESLA_CLIENT_ID=b4a07679-8597-452d-a7c0-8a6a6b632c42
TESLA_CLIENT_SECRET=

# Redirect URI registered with Tesla — must match exactly what's in the Tesla developer portal
TESLA_REDIRECT_URI=https://ev-dashboard.penndalton.com/auth/callback

# Path where keys/ and tokens are stored (set by docker-compose)
KEYS_DIR=/app/keys

# InfluxDB dual-write (telemetry sidecar). When ALL FOUR are set, writeState()
# in server/telemetry-server.js POSTs each merged telemetry state to InfluxDB in
# addition to keys/tesla-state.json. Leave any one unset to disable (no-op) —
# the JSON write is unaffected. Influx v2 (org/bucket/token), live at :8086.
#INFLUX_URL=http://10.0.6.61:8086
#INFLUX_TOKEN=
#INFLUX_ORG=
#INFLUX_BUCKET=
# Optional — measurement name (defaults to ev_telemetry):
#INFLUX_MEASUREMENT=ev_telemetry

# Rivian charge control: 1 = the dashboard writes the Rivian charging schedule
# (00:00-08:00, amps from the daily plan or an override). Unset = show only.
# RIVIAN_SCHEDULE_CONTROL=1

# Demand-aware night plan (EV plan Rev 18): picks nights and amps to stay under the
# forecast day peak from the NV usage in Influx. Off by default: on 2026 data it did
# not beat the plain lowest-amp plan. 1 = on.
# RIVIAN_PEAK_PLAN=1

# Nextcloud "EV Charge Forecast" calendar: one all-day event per day for the next 14 days, titled with
# the day's forecast driving (EV 34 mi). Change the number in a title (EV 60 mi or EV 25%) to raise that
# day's plan (it only raises); delete the event or type auto to go back to the forecast. Off unless one of
# the next two is set. Create the calendar in your own Nextcloud account and share it to the dashboard's
# user with edit rights; it then shows up under that user's calendar home.
# FORECAST_CAL_NAME=EV Charge Forecast
# Explicit CalDAV collection URL instead of the name lookup (wins over the name), e.g.
# https://cloud.example.com/remote.php/dav/calendars/ev-dashboard/ev-charge-forecast-shared-by-you/
# FORECAST_CAL_URL=
# Login for it; each falls back to PERSONAL_CAL_USER / PERSONAL_CAL_PASSWORD. The name lookup also
# takes its server from PERSONAL_CAL_URL when FORECAST_CAL_URL is not set.
# FORECAST_CAL_USER=
# FORECAST_CAL_PASSWORD=

# Work shift calendar (ICS feed). Nights before a shift plan for the recent
# work-day kWh/day when that is above the daily average (Rivian). webcal://
# links work. For a Nextcloud calendar export later, add an app password.
# SHIFTS_ICS_URL=webcal://...
# SHIFTS_ICS_USER=
# SHIFTS_ICS_PASSWORD=

# Base URL of this dashboard, for the tap-through link in shift-conflict pushes
# (opens /shifts?day=...).
# DASHBOARD_URL=https://ev.example.com

# Panel feed (GET /api/panel, for the ESP32 round display in firmware/crowpanel-21). Read-only; a missing URL makes
# that section ok=0 on the panel instead of failing the request.
# bloom-ledger base URL (Darkbloom state, watts, alerts, earnings per Mac), e.g. http://<unraid-or-ledger-ip>:8787
# PANEL_BLOOM_LEDGER_URL=
# network-bandwidth-monitor base URL (Cox + Starlink WAN Mbps), port 8080. Unset: Unraid's own traffic from Influx.
# PANEL_NETMON_URL=
# Unraid metrics (unraid_disk / unraid_array / unraid_net) are read from the Influx server above (INFLUX_URL, INFLUX_ORG),
# but live in a different bucket than the telemetry write: the bucket defaults to "metrics". The telemetry token may be
# write-only, so give a read token here when it is.
# PANEL_INFLUX_BUCKET=metrics
# PANEL_INFLUX_TOKEN=
